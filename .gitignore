# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Sentry Config File
.env.sentry-build-plugin

# offline validation artifacts
ops/comp-leave-import-validation/**/*.db
ops/comp-leave-import-validation/**/*.db-*
ops/comp-leave-import-validation/**/*.db.gz

# local databases & data (never commit real data)
*.db
*.db-*
*.db.*
*.sqlite
backups/

# local reference material
*.pdf

# local tooling / session logs
.claude/
.recall/

# playwright output
/test-results/
/playwright-report/

# one-off repair scripts containing real employee data (keep local only)
scripts/repair-july-2026-payroll-base-pay.ts
scripts/ensure-target-permissions.cjs
scripts/ensure-target-permissions.ts
src/lib/target-permission-provisioning.ts
src/lib/__tests__/target-permission-provisioning.test.ts
